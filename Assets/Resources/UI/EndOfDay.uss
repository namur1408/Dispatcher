/* EndOfDay.uss — balanced, readable, mobile landscape */

.container {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: #000000;
    align-items: center;
    justify-content: center;
    padding: 8px;
}

.panel {
    width: 100%;
    height: 100%;
    max-width: 1000px;
    background-color: transparent;
    border-color: #1a4a1a;
    border-width: 1px;
    padding: 8px 14px 22px 14px;
    position: relative;
    opacity: 0;
    translate: 0 10px;
    transition-property: opacity, translate;
    transition-duration: 0.5s;
    flex-direction: column;
    overflow: hidden;
}

.panel.visible {
    opacity: 1;
    translate: 0 0;
}

/* Corners */
.corner { position: absolute; width: 12px; height: 12px; border-color: #00c840; }
.top-left    { top: 5px; left: 5px;   border-top-width: 2px; border-left-width: 2px; }
.top-right   { top: 5px; right: 5px;  border-top-width: 2px; border-right-width: 2px; }
.bottom-left { bottom: 5px; left: 5px;  border-bottom-width: 2px; border-left-width: 2px; }
.bottom-right{ bottom: 5px; right: 5px; border-bottom-width: 2px; border-right-width: 2px; }

/* ── TOP BAR ─────────────────────────────────────────── */
.top-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.title-block {
    flex-grow: 1;
    flex-shrink: 1;
    padding-right: 12px;
}

.title-text {
    font-size: 34px;
    -unity-font-style: bold;
    color: #00ff55;
    letter-spacing: 3px;
    text-shadow: 0 0 8px #00ff55;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.sub-title {
    font-size: 15px;
    color: #1a5a1a;
    letter-spacing: 2px;
    margin-top: 1px;
    white-space: nowrap;
}

.rep-block {
    flex-shrink: 0;
    align-items: flex-end;
    min-width: 150px;
}

.rep-label {
    font-size: 13px;
    color: #2a6a2a;
    letter-spacing: 2px;
    margin-bottom: 1px;
}

.rep-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.rep-val {
    font-size: 25px;
    color: #00ff55;
    letter-spacing: 1px;
    margin-right: 3px;
}

.rep-val-max {
    font-size: 15px;
    color: #1a4a1a;
    letter-spacing: 1px;
    margin-right: 6px;
}

.level-badge {
    font-size: 13px;
    -unity-font-style: bold;
    background-color: #00ff55;
    color: #000;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
    letter-spacing: 1px;
}

.rep-bar-container {
    height: 3px;
    width: 180px;
    background-color: #0a1a0a;
    border-width: 1px;
    border-color: #1a3a1a;
    overflow: hidden;
}

.rep-bar-fill {
    height: 100%;
    width: 0%;
    background-color: #00c840;
    transition-property: width;
    transition-duration: 1.4s;
    transition-timing-function: ease-in-out;
}

/* ── Dividers ─────────────────────────────────────────── */
.dashed-divider {
    border-top-width: 1px;
    border-color: #1a3a1a;
    margin-top: 3px;
    margin-bottom: 3px;
    flex-shrink: 0;
}

/* ── STATS GRID ───────────────────────────────────────── */
.stats-grid {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

.stats-col {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: flex-start;   /* ← rows stay at top, no stretching */
    align-items: stretch;
    min-height: 0;
    overflow: hidden;
}

.col-divider {
    width: 1px;
    background-color: #1a3a1a;
    margin-left: 10px;
    margin-right: 10px;
    flex-shrink: 0;
}

/* ── Section header ──────────────────────────────────── */
.section-header {
    font-size: 16px;
    color: #2a7a2a;
    letter-spacing: 3px;
    border-bottom-width: 1px;
    border-color: #0f2a0f;
    padding-bottom: 4px;
    margin-bottom: 3px;
    margin-top: 5px;
    flex-shrink: 0;
    white-space: nowrap;
}

/* ── Stat rows — fixed height, no flex-grow ──────────── */
.stat-row {
    flex-direction: row;
    align-items: center;
    padding-top: 7px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-color: #071407;
    flex-shrink: 0;
}

.stat-name {
    flex-grow: 1;
    font-size: 19px;
    color: #00a030;
    letter-spacing: 1px;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
}

.stat-bar-bg {
    width: 50px;
    height: 3px;
    background-color: #050f05;
    border-radius: 2px;
    overflow: hidden;
    margin-right: 5px;
    margin-left: 5px;
    flex-shrink: 0;
}

.stat-bar-fill {
    height: 100%;
    width: 0%;
    border-radius: 2px;
    transition-property: width;
    transition-duration: 1.2s;
    transition-timing-function: ease-in-out;
}

.stat-val {
    width: 58px;
    -unity-text-align: middle-right;
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    flex-shrink: 0;
}

/* ── Food big display ────────────────────────────────── */
.food-big-block {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 8px;
    padding-top: 4px;
    border-top-width: 1px;
    border-color: #1a3a1a;
}

.food-big-label {
    flex-grow: 1;
    font-size: 18px;
    color: #00ff55;
    letter-spacing: 2px;
}

.food-big-val {
    font-size: 46px;
    -unity-font-style: bold;
    color: #00ff55;
    text-shadow: 0 0 10px rgba(0, 255, 85, 0.6);
}

/* ── BOTTOM BAR ───────────────────────────────────────── */
.bottom-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 4px;
}

.xp-block {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    background-color: rgba(0, 200, 60, 0.04);
    border-color: #0f2a0f;
    border-width: 1px;
    padding: 5px 10px;
    margin-right: 10px;
    position: relative;
}

.xp-left-border {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background-color: #00c840;
}

.xp-title {
    font-size: 20px;
    color: #4a8a4a;
    letter-spacing: 2px;
    white-space: nowrap;
}

.xp-subtitle {
    font-size: 13px;
    color: #1a4a1a;
    letter-spacing: 1px;
    margin-top: 1px;
    white-space: nowrap;
}

.xp-gain-val {
    font-size: 44px;
    -unity-font-style: bold;
    color: #00ff55;
    text-shadow: 0 0 12px rgba(0, 255, 85, 0.7);
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    height: 38px;
    flex-shrink: 0;
    margin-left: 10px;
}

.xp-gain-unit {
    font-size: 19px;
    color: #2a6a2a;
    margin-left: 3px;
    -unity-text-align: middle-left;
    height: 28px;
    flex-shrink: 0;
}

.xp-penalty-val {
    font-size: 16px;
    color: #ff4444;
    letter-spacing: 1px;
}

/* ── Sleep button ────────────────────────────────────── */
.sleep-btn {
    flex-shrink: 0;
    background-color: transparent;
    border-color: #1a4a1a;
    border-width: 1px;
    color: #4a8a4a;
    font-size: 18px;
    letter-spacing: 3px;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 18px;
    padding-right: 18px;
    transition-property: border-color, color;
    transition-duration: 0.2s;
    white-space: nowrap;
}

.sleep-btn:hover  { border-color: #00ff55; color: #00ff55; }
.sleep-btn.sleeping {
    border-color: #00ff55;
    color: #00ff55;
    text-shadow: 0 0 8px rgba(0, 255, 85, 0.6);
}

/* ── Footer ──────────────────────────────────────────── */
.footer {
    position: absolute;
    bottom: 7px;
    font-size: 13px;
    color: #1a3a1a;
    letter-spacing: 2px;
}
.footer-left  { left: 14px; }
.footer-right { right: 14px; }
